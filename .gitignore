# PDF пособий — локально; структура папок — в git (.gitkeep)
toExtract/*
!toExtract/.gitkeep
!toExtract/*/
toExtract/*/*
!toExtract/*/.gitkeep
node_modules/
dist/
app/public/content/
app/test-results/
app/playwright-report/
*.tsbuildinfo
.idea/
.cursor/
__pycache__/
*.pyc
.env
.DS_Store
docs/superpowers/
